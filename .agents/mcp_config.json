{
  "mcpServers": {
    "shadcn": {
      "command": "npx",
      "args": ["shadcn@latest", "mcp"]
    },
    "21st": {
      "url": "https://21st.dev/api/mcp",
      "headers": {
        "x-api-key": "$API_KEY_21ST"
      }
    },
    "motion": {
      "url": "https://mcp.motion.dev"
    },
    "motion-plus": {
      "url": "https://mcp.motion.dev/plus"
    }
  }
}
